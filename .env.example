# Public Hugging Face Space ID, e.g. owner/space-name
# Choose a Space that explicitly allows free use and exposes a text-to-video endpoint.
VIDEO_SPACE_ID=

# Optional Hugging Face token ONLY if the Space requires authentication.
# Keep this server-side. Never prefix it with NEXT_PUBLIC_.
HF_TOKEN=

# Endpoint shown in the Space's "Use via API" panel, e.g. /predict or /generate.
# The endpoint and inputs differ between Spaces.
VIDEO_API_NAME=/predict

# Optional: maximum prompt length (default 1000)
MAX_PROMPT_LENGTH=1000
